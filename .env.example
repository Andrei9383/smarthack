# Names only, never values. Copy to .env (git-ignored) and fill in locally / as lab secrets.

# Live 15-min feed (card #128, team/contracts/live.md)
SENTINEL_LIVE_DB=            # SQLite path the feed writes and the app's live view reads (default demo/live.sqlite)
SENTINEL_WINDOWS=            # #10 window cache for --world sim (default ~/.cache/sentinel/data-v{N}/windows)

# Vendor telemetry adapters (card #131, not built yet): real readings need these plus site-to-feeder mapping,
# feeder limits, retrained models and customer consent. Changing keys alone is not enough.
FUSIONSOLAR_API_URL=
FUSIONSOLAR_USER=
FUSIONSOLAR_SYSTEM_CODE=
SMA_CLIENT_ID=
SMA_CLIENT_SECRET=
