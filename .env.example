# Optional settings. Copy to .env and fill in what you need.

# Database the app reads (default: demo/wattsentry.sqlite, then demo/fixtures.sqlite).
DATABASE_URL=

# Live 15-minute feed: SQLite file scripts/live_feed.py writes and the app's live view reads
# (default demo/live.sqlite).
WATTSENTRY_LIVE_DB=

# Voice narration and "Ask WattSentry" (ElevenLabs). Without a key the voice controls stay hidden.
ELEVENLABS_API_KEY=
