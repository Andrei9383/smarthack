# Names only, never values. Copy to .env (git-ignored) and fill in locally / as lab secrets.

# Live 15-min feed (card #128, team/contracts/live.md)
WATTSENTRY_LIVE_DB=            # SQLite path the feed writes and the app's live view reads (default demo/live.sqlite)
WATTSENTRY_WINDOWS=            # #10 window cache for --world sim (default ~/.cache/wattsentry/data-v{N}/windows)

# Vendor telemetry adapters (card #131, not built yet): real readings need these plus site-to-feeder mapping,
# feeder limits, retrained models and customer consent. Changing keys alone is not enough.
FUSIONSOLAR_API_URL=
FUSIONSOLAR_USER=
FUSIONSOLAR_SYSTEM_CODE=
SMA_CLIENT_ID=
SMA_CLIENT_SECRET=

# Voice (card #207): ElevenLabs story narration + "Ask Sentinel". Get a key with
# `npx -y @elevenlabs/cli@latest onboard init`; without it the voice controls stay hidden.
ELEVENLABS_API_KEY=
