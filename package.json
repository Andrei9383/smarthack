{
  "name": "wattsentry",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev -F web --",
    "db:push": "turbo run db:push -F @wattsentry/db --",
    "db:studio": "turbo run db:studio -F @wattsentry/db --",
    "db:generate": "turbo run db:generate -F @wattsentry/db --",
    "db:migrate": "turbo run db:migrate -F @wattsentry/db --",
    "test": "turbo run check-types",
    "start": "npm run start --workspace web"
  },
  "devDependencies": {
    "@wattsentry/config": "*",
    "@types/node": "^26.4.1",
    "turbo": "^2.11.7",
    "typescript": "^6.0.3"
  },
  "packageManager": "npm@11.6.2",
  "allowScripts": {
    "esbuild": true,
    "sharp": true
  }
}
