{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "lab hook session-start --agent gemini",
            "timeout": 20000
          }
        ]
      }
    ],
    "BeforeAgent": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "lab hook prompt --agent gemini",
            "timeout": 30000
          }
        ]
      }
    ],
    "AfterTool": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "lab hook post-tool --agent gemini",
            "timeout": 5000
          }
        ]
      }
    ]
  }
}
